# Copy to .env.local for local development. Never commit real values.

# Database (Neon via the Vercel Marketplace sets this automatically on Vercel; use the POOLED url)
DATABASE_URL=postgres://omni:omni@localhost:5432/omniresolve

# LLM providers (optional — without them the app runs in REPLAY mode on recorded model outputs)
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=

# Secrets (32+ random characters each; generate with: openssl rand -hex 32)
SESSION_SECRET=change_me_to_32_plus_random_characters_000
APPROVAL_SIGNING_SECRET=change_me_to_32_plus_random_characters_111
CRON_SECRET=change_me

# Limits
GLOBAL_DAILY_LLM_CALLS=800
AUTO_REFUND_LIMIT_CENTS_OVERRIDE=
DEFAULT_MODE=replay

# Optional: route LLM calls through an OpenAI-compatible gateway
LLM_BASE_URL=
